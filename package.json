{
  "name": "sport-elements-performance-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup:cloud": "bash scripts/setup-cloud.sh",
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "backfill:garmin": "node scripts/backfill-garmin-relational.mjs",
    "coach:normalize": "node scripts/coach-context/generate-normalized-fixtures.mjs",
    "coach:inspect": "node scripts/coach-context/inspect-coach-context-fixtures.mjs",
    "coach:supabase:inspect": "node scripts/coach-context/inspect-normalized-for-supabase.mjs",
    "coach:supabase:plan": "node scripts/coach-context/plan-supabase-seed.mjs",
    "coach:supabase:seed-sql": "node scripts/coach-context/generate-supabase-seed-sql.mjs",
    "coach:supabase:seed-v1": "node scripts/coach-context/generate-coach-context-seed-sql.mjs",
    "coach:supabase:dev-preflight": "node scripts/coach-context/preflight-dev-apply.mjs",
    "coach:supabase:dev-verify-sql": "node scripts/coach-context/generate-dev-apply-verification-sql.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "test:coach-evals": "node --test tests/coach-contract-evals.test.mjs",
    "prepare:local-language-lab": "node scripts/local-language/export-eval-dataset.mjs",
    "predev": "npm run prepare:local-language-lab",
    "prebuild": "npm run prepare:local-language-lab",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "mcp:local": "node scripts/mcp-local.mjs",
    "test:mcp": "node --test tests/enqidu-mcp*.test.mjs",
    "test:tools": "node --test tests/enqidu-tools*.test.mjs tests/enqidu-action*.test.mjs",
    "tools:manifest": "node scripts/enqidu-tools-manifest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fit-file-parser": "^3.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@playwright/test": "1.63.0"
  }
}
